{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core APIs, window dragging, and native dialogs, notifications and self-update. No shell or fs access.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "core:webview:allow-set-webview-zoom",
    "core:window:allow-set-theme",
    "notification:default",
    "updater:default",
    "process:allow-restart"
  ]
}
